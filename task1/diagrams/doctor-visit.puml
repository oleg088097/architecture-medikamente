@startuml
title Doctor Visit

actor Клиент
actor Врач

(1.0\nПосещение врача) as VisitProc

rectangle "Файловый сервер" as fileServer
rectangle Excel

database "D1: Файл журнала записи врача Excel" as xlsx
database "D2: Файлы пациента" as patientFiles

xlsx --> fileServer : Доступ к журналу\n PII, APPOINTMENT (Дата, время, врач)
